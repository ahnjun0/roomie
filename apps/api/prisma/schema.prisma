// 1. 설정 영역
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider             = "prisma-client-py"
  interface            = "asyncio"
  recursive_type_depth = 5
}

// --------------------------------------

// 2. 사용자 모델 (Screen 1, 2)
model User {
  id          String   @id                           // CUID2 (앱에서 생성)
  email       String   @unique                       // 학교 이메일
  nickname    String?
  password    String   // 해시된 비밀번호

  gender      Gender   // 성별 (Enum)
  studentId   Int      // 학번 (23, 24)
  age         Int
  nationality Nationality

  // 학교 연결
  school      School?  @relation(fields: [schoolId], references: [id])
  schoolId    Int?

  // 관계 설정 (1:1, 1:N)
  lifestyle   UserLifestyle?   // 나의 생활 패턴
  preference  UserPreference?  // 나의 선호 조건

  // 내가 쓴 리뷰들
  writtenReviews Review[] @relation("WrittenReviews")
  // 내가 받은 리뷰들
  receivedReviews Review[] @relation("ReceivedReviews")

  // 채팅
  chatParticipants ChatParticipant[]
  chatMessages     ChatMessage[]

  // 배달 파티
  deliveryPosts        DeliveryPost[]        @relation("DeliveryAuthor")
  deliveryParticipants DeliveryParticipant[]
  deliveryMessages     DeliveryMessage[]

  // 매칭 결과 캐시
  matchResultsAsUser   MatchResult[] @relation("MatchUser")
  matchResultsAsTarget MatchResult[] @relation("MatchTarget")

  // 매칭 히스토리
  matchHistoriesAsUserA MatchHistory[] @relation("MatchHistoryUserA")
  matchHistoriesAsUserB MatchHistory[] @relation("MatchHistoryUserB")

  // Room-BTI 결과
  roomBtiResult      String?   // "SCDS", "PFNI" 등 4글자 코드
  roomBtiAnimal      String?   // "부지런한 미어캣"
  roomBtiDescription String?   // 설명 텍스트

  // 헬프 요청 게시글
  helpPosts   HelpPost[]

  // 留ㅼ묶 ?곹깭
  matchingStatus MatchingStatus @default(SEARCHING)

  createdAt   DateTime @default(now())
  contractsAsUserA RoommateContract[] @relation("ContractUserA")
  contractsAsUserB RoommateContract[] @relation("ContractUserB")
}

// 3. 나의 생활 패턴 (Fact) - (Screen 3, 4, 5, 7)
model UserLifestyle {
  id        Int     @id @default(autoincrement())
  user      User    @relation(fields: [userId], references: [id])
  userId    String  @unique

  // 기숙사 (복수 선택 가능 - 쉼표로 구분)
  dormNames String  // "성실관,봉사관,진리관"

  isSmoker  Boolean // 흡연 여부 (필터링용)

  // 수면 관련
  sleepStart  Int     // 취침 시간 0~30 (예: 23=밤11시, 26=새벽2시)
  sleepEnd    Int     // 기상 시간
  sleepHabits String? // 잠버릇 태그 "SNORING,GRINDING,TALKING,TOSSING,NONE"

  // 생활 스타일 (모두 1~5점 척도)
  noiseLevel  Int @default(3)  // 소음 민감도 (1=둔함, 5=예민)
  cleanLevel  Int @default(3)  // 청결도 (1=안치움, 5=결벽)
  foodLevel   Int @default(3)  // 실내취식 (1=절대불가, 5=배달OK)
  tempLevel   Int @default(3)  // 온도 선호 (1=추위탐, 5=더위탐)

  // 기타
  homeVisit   String? // 본가 방문 주기 (WEEKLY, BI_WEEKLY, MONTHLY, RARELY)
}

// 4. 선호 조건 & 5만원 게임 가중치 (Preference) - (Screen 6, 7, 8)
model UserPreference {
  id        Int     @id @default(autoincrement())
  user      User    @relation(fields: [userId], references: [id])
  userId    String  @unique

  // 기본 선호 (Screen 6)
  prefNationality Nationality? // 선호 국적 (null이면 무관)
  prefStudentId   String?      // SAME, SENIOR, JUNIOR, ANY

  // 5만원 게임 가중치 (Screen 8)
  // 값 = 베팅액 / 1000 (예: 10000원 → 10, 0원 → 0)
  weightNoise  Int @default(0)  // 소음
  weightClean  Int @default(0)  // 청결
  weightFood   Int @default(0)  // 실내취식
  weightHabit  Int @default(0)  // 잠버릇
  weightTime   Int @default(0)  // 취침시간
  weightTemp   Int @default(0)  // 온도
}

// 5. 리뷰 및 평가 (Screen 10)
model Review {
  id        Int      @id @default(autoincrement())

  reviewer    User @relation("WrittenReviews", fields: [reviewerId], references: [id])
  reviewerId  String

  target      User @relation("ReceivedReviews", fields: [targetId], references: [id])
  targetId    String
  
  content   String   // "청소를 잘해요"
  score     Int      // 1~5점
  
  createdAt DateTime @default(now())
}

// 6. 채팅방
model ChatRoom {
  id        String   @id @default(uuid())

  participants ChatParticipant[]
  messages     ChatMessage[]

  createdAt DateTime @default(now())
  contract RoommateContract?
}

model ChatParticipant {
  id         Int      @id @default(autoincrement())

  chatRoom   ChatRoom @relation(fields: [chatRoomId], references: [id])
  chatRoomId String

  user       User     @relation(fields: [userId], references: [id])
  userId     String

  joinedAt   DateTime @default(now())

  @@unique([chatRoomId, userId])
}

model ChatMessage {
  id         String   @id @default(uuid())

  chatRoom   ChatRoom @relation(fields: [chatRoomId], references: [id])
  chatRoomId String

  sender     User     @relation(fields: [senderId], references: [id])
  senderId   String

  content    String

  createdAt  DateTime @default(now())
}

// 6-3. 배달 파티 모집글
model DeliveryPost {
  id              String   @id @default(cuid())

  title           String
  content         String
  foodCategory    String
  orderLink       String?
  bankAccount     String?
  maxParticipants Int
  isClosed        Boolean  @default(false)

  author          User     @relation("DeliveryAuthor", fields: [authorId], references: [id])
  authorId        String

  participants    DeliveryParticipant[]
  messages        DeliveryMessage[]

  createdAt       DateTime @default(now())
}

// 6-4. 배달 파티 참여자
model DeliveryParticipant {
  id             Int          @id @default(autoincrement())

  deliveryPost   DeliveryPost @relation(fields: [deliveryPostId], references: [id])
  deliveryPostId String

  user           User         @relation(fields: [userId], references: [id])
  userId         String

  joinedAt       DateTime     @default(now())

  @@unique([deliveryPostId, userId])
}

// 6-5. 배달 파티 메시지
model DeliveryMessage {
  id             String   @id @default(cuid())

  deliveryPost   DeliveryPost @relation(fields: [deliveryPostId], references: [id])
  deliveryPostId String

  sender         User     @relation(fields: [senderId], references: [id])
  senderId       String

  content        String

  createdAt      DateTime @default(now())
}

// 6-1. 猷몃찓?댄듃 怨꾩빟??
model RoommateContract {
  id           String   @id @default(cuid())

  chatRoom     ChatRoom @relation(fields: [chatRoomId], references: [id])
  chatRoomId   String

  userA        User     @relation("ContractUserA", fields: [userAId], references: [id])
  userAId      String

  userB        User     @relation("ContractUserB", fields: [userBId], references: [id])
  userBId      String

  status       ContractStatus @default(DRAFT)
  contractData Json

  signatureA   Boolean @default(false)
  signatureB   Boolean @default(false)
  signedAt     DateTime?

  endSemesterA Boolean @default(false)
  endSemesterB Boolean @default(false)

  @@unique([chatRoomId])
}

// 6-2. 매칭 히스토리
model MatchHistory {
  id        String   @id @default(cuid())

  userA     User     @relation("MatchHistoryUserA", fields: [userAId], references: [id])
  userAId   String

  userB     User     @relation("MatchHistoryUserB", fields: [userBId], references: [id])
  userBId   String

  matchedAt DateTime @default(now())

  @@unique([userAId, userBId])
}

// 7. 학교 정보
model School {
  id        Int      @id @default(autoincrement())
  name      String   @unique  // "KAIST", "부산대학교"
  domain    String?  // "kaist.ac.kr" - 이메일 도메인 검증용

  dorms     Dorm[]   // 소속 기숙사들
  users     User[]   // 소속 학생들

  createdAt DateTime @default(now())
}

// 8. 기숙사 정보 (학교별)
model Dorm {
  id        Int      @id @default(autoincrement())

  school    School   @relation(fields: [schoolId], references: [id])
  schoolId  Int

  name      String   // "사랑관", "소망관"
  gender    Gender   // 입사 가능 성별
  roomType  String?  // "2인실", "4인실"
  capacity  Int?     // 수용 인원

  @@unique([schoolId, name])  // 같은 학교 내 기숙사명 중복 방지
}

// 9. 매칭 결과 캐시 (성능 최적화)
model MatchResult {
  id           Int      @id @default(autoincrement())

  user         User     @relation("MatchUser", fields: [userId], references: [id])
  userId       String

  targetUser   User     @relation("MatchTarget", fields: [targetUserId], references: [id])
  targetUserId String

  score        Float    // 매칭 점수 (0-100)
  breakdown    String?  // JSON 형태의 항목별 점수

  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())

  @@unique([userId, targetUserId])  // 유저 쌍당 하나의 결과만
  @@index([userId, score(sort: Desc)])  // 조회 성능 최적화
}

// 10. 헬프 요청 게시판 (Help Center)
model HelpPost {
  id        String   @id                // CUID2 (앱에서 생성)

  author    User     @relation(fields: [authorId], references: [id])
  authorId  String

  category  HelpCategory              // BUG(벌레퇴치), REPAIR(고장신고)
  title     String                    // 제목
  content   String                    // 내용 (긴 텍스트)
  images    String[]                  // 사진 URL 리스트

  status    HelpStatus @default(OPEN) // OPEN(진행중), SOLVED(해결됨)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([authorId])
  @@index([category, status])         // 카테고리+상태 필터링 최적화
  @@index([createdAt(sort: Desc)])    // 최신순 정렬 최적화
}

// Enum 정의 (고정된 값들)
enum Gender {
  MALE
  FEMALE
}

enum MatchingStatus {
  SEARCHING
  MATCHED
}

enum ContractStatus {
  DRAFT
  SIGNED
}

enum Nationality {
  KOREAN
  FOREIGNER
}

enum HelpCategory {
  BUG      // 벌레 퇴치
  REPAIR   // 고장 신고
}

enum HelpStatus {
  OPEN     // 진행 중
  SOLVED   // 해결 완료
}
